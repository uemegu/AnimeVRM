    "lines": [
      {
        "lineId": "motion_emily_ready",
        "text": "「ふふっ、甘いわねアオイ。スピード線の本気を見たいなら、私の鋭いストレートパンチを見てなさい！」",
        "voiceUrl": "/voices/fastmotion_03_emily.mp3"
      },
      {
        "lineId": "motion_emily_punch",
        "text": "「せいっ！やあっ！――腕の軌跡に沿うスピード線、背後に残る残像、そして逆方向に伸びるぼかしアウトライン！」",
        "voiceUrl": "/voices/fastmotion_04_emily.mp3"
      },
      {
        "lineId": "motion_outro",
        "text": "「腕も脚も、一定以上の速度で振り抜いた瞬間だけ自動発生するわ。これぞアニメ作画の真骨頂ね！」",
        "voiceUrl": "/voices/fastmotion_06_emily.mp3"
      }
    ]
  },
  {
