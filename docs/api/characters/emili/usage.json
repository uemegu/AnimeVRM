  {
    "category": "demo",
    "id": "private_date",
    "title": "休日デート〜私服のエミリと街歩き〜",
    "appearances": 25,
    "lines": [
      {
        "lineId": "door_1",
        "text": "「おはよー！ 待たせちゃった？ 今日の私服……どうかな、似合ってる？」",
        "voiceUrl": "/voices/date_emili_01.mp3"
      },
      {
        "lineId": "door_choice_1",
        "text": "「ほんと！？ えへへ……嬉しいな！ 実は今日のために色々悩んで選んだんだ♪」",
        "voiceUrl": "/voices/date_emili_02a.mp3"
      },
      {
        "lineId": "door_choice_2",
        "text": "「大人っぽい！？ ……そ、そうかな？ えへへ、ちょっと照れちゃうけど嬉しい♪」",
        "voiceUrl": "/voices/date_emili_02b.mp3"
      },
      {
        "lineId": "door_depart",
        "text": "「それじゃ、今日のデート……しゅっぱーつ！」",
        "voiceUrl": "/voices/date_emili_03.mp3"
      },
      {
        "lineId": "walk_1",
        "text": "「こうして並んで歩くの、なんだかドキドキしちゃうね……！ お天気も最高だし♪」",
        "voiceUrl": "/voices/date_emili_04.mp3"
      },
      {
        "lineId": "walk_2",
        "text": "「ねえねえ、まずはどこから行く？ 行きたいお店、いっぱいチェックしてきたんだ〜！」",
        "voiceUrl": "/voices/date_emili_05.mp3"
      },
      {
        "lineId": "walk_3",
        "text": "「……ふふっ、私の横顔ばっかり見てどうしたの？ 照れちゃうじゃん！」",
        "voiceUrl": "/voices/date_emili_06.mp3"
      },
      {
        "lineId": "shion_2",
        "text": "「シ、シオン！？ なんでこんなところに……！ べ、別にデートじゃないし……あ、いやデートだけど！」",
        "voiceUrl": "/voices/date_emili_07.mp3"
      },
      {
        "lineId": "shion_4",
        "text": "「もーっ！ シオンったら急に現れてからかうんだから！ ……ふぅ、びっくりした。気を取り直して行こっ！」",
        "voiceUrl": "/voices/date_emili_08.mp3"
      },
      {
        "lineId": "cafe_2",
        "text": "「アオイ！ アオイも私服でお買い物？ すっごく似合ってて可愛い〜！」",
        "voiceUrl": "/voices/date_emili_09.mp3"
      },
      {
        "lineId": "cafe_4",
        "text": "「うん！ ちょっと休憩にお茶しよって話してて。アオイも一緒にどう？」",
        "voiceUrl": "/voices/date_emili_10.mp3"
      },
      {
        "lineId": "cafe_6",
        "text": "「そっか、残念！ また学校でゆっくりお話しよ！」",
        "voiceUrl": "/voices/date_emili_11.mp3"
      },
      {
        "lineId": "park_1",
        "text": "「ふぅ……！ 今日一日、すっごく楽しかったな。あっという間に夕方になっちゃったね。」",
        "voiceUrl": "/voices/date_emili_12.mp3"
      },
      {
        "lineId": "park_2",
        "text": "「街でシオンにからかわれたり、カフェでアオイに会ったり……賑やかだったけど……」",
        "voiceUrl": "/voices/date_emili_13.mp3"
      },
      {
        "lineId": "park_3",
        "text": "「でもね……あなたと過ごした今日の時間、私にとってすごく特別だったよ。」",
        "voiceUrl": "/voices/date_emili_14.mp3"
      },
      {
        "lineId": "park_choice_1",
        "text": "「えへへ、そう言ってもらえて幸せだな……♪」",
        "voiceUrl": "/voices/date_emili_15a.mp3"
      },
      {
        "lineId": "park_choice_2",
        "text": "「うんっ……！ 絶対、またデートしてね。約束だよ♪」",
        "voiceUrl": "/voices/date_emili_15b.mp3"
      },
      {
        "lineId": "park_ending",
        "text": "「今日は本当にありがとう！ 来週も……楽しみにしてるね！」",
        "voiceUrl": "/voices/date_emili_16.mp3"
      }
    ]
  },
