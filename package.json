{
  "name": "vrm-toon-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "asc assembly/index.ts --config asconfig.json",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "convert:textures": "bash convert_textures.sh",
    "ardy:generate": "node scripts/ardy-generate.ts",
    "ardy:calibrate": "node scripts/ardy-calibrate.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p app && npm run typecheck --workspaces --if-present",
    "server": "npm run dev -w server",
    "studio": "npm run dev -w studio",
    "build:pages": "npm run build:pages -w studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "assemblyscript": "^0.28.20",
    "typescript": "^7.0.2",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@anime-vrm/engine": "*",
    "@huggingface/tokenizers": "0.1.3",
    "@pixiv/three-vrm": "^3.5.5",
    "ardy-onnxruntime-web": "npm:onnxruntime-web@1.27.0",
    "meyda": "^5.6.3",
    "three": "^0.183.2"
  },
  "workspaces": [
    "app",
    "packages/*",
    "server",
    "studio"
  ]
}
