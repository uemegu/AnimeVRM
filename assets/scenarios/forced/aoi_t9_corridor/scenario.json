{
  "id": "aoi_t9_corridor",
  "title": {
    "ja": "夕暮れの渡り廊下: もう戻れない"
  },
  "availability": {
    "timeSlots": [
      "afterschool"
    ],
    "dayRange": {
      "from": 18,
      "to": 18
    },
    "requireFlags": [
