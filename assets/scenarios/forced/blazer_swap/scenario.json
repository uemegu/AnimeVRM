{
  "id": "blazer_swap",
  "title": {
    "ja": "昼休み: ブレザー交換っこ"
  },
  "availability": {
    "timeSlots": [
      "afternoon"
    ],
    "dayRange": {
      "from": 9,
      "to": 9
    },
    "unlessFlags": [
