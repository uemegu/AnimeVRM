  "scenes": [
    {
      "id": "s1",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "飲みな。頭冷やすのにちょうどいいでしょ",
      "background": "corridor",
      "timeOfDay": "evening",
      "avatars": {
        "teacher": {
          "position": "center",
          "expression": "neutral",
          "expressionWeight": 1,
          "motion": "Standing Idle",
          "lookAtTarget": "camera"
        }
      },
      "camera": "medium",
      "cutin": "/cutins/items/canned_coffee.avif",
      "voiceUrl": "v_s1_76194dfd.mp3"
    },
    {
      "id": "s2",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "……先生。もし、誰かを好きになったきっかけが、誰かに仕組まれたものだったら……その気持ちって、偽物ですか",
      "cutin": false
    },
    {
      "id": "s3",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "……ずいぶん哲学的なこと聞くじゃない",
      "avatars": {
        "teacher": {
          "expression": "surprised",
          "expressionWeight": 1
        }
      },
      "voiceUrl": "v_s3_9ff916b5.mp3"
    },
    {
      "id": "s4",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "古典で『縁』って習ったでしょ。昔の人は、出会いのきっかけなんて全部神様のせいにしてたのよ",
      "avatars": {
        "teacher": {
          "expression": "relaxed",
          "expressionWeight": 1,
          "motion": "chin_rest",
          "lookAtTarget": "forward"
        }
      },
      "voiceUrl": "v_s4_08a37c6d.mp3"
    },
    {
      "id": "s5",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "隣の席になったのも、雨宿りで一緒になったのも、全部『縁』",
      "voiceUrl": "v_s5_2485475f.mp3"
    },
    {
      "id": "s6",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "……はい"
    },
    {
      "id": "s7",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "でもさ、その縁を続けたのは神様じゃなくて、本人たちなんだよ",
      "avatars": {
        "teacher": {
          "lookAtTarget": "camera",
          "motion": "Standing Idle"
        }
      },
      "voiceUrl": "v_s7_313f5cec.mp3"
    },
    {
      "id": "s8",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "大事なのは、きっかけの後に、自分で何を選んだか",
      "camera": "close",
      "voiceUrl": "v_s8_200c2273.mp3"
    },
    {
      "id": "s9",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "（蔵で、震えるシオンの隣に座ったのは……神様の風じゃない。俺が選んだことだ）",
      "camera": "medium"
    },
    {
      "id": "s10",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "あいつ、入学してからずっと本と壁しか見てなかったのにね。最近は、あんたの背中を目で追ってるよ",
      "avatars": {
        "teacher": {
          "expression": "nima",
          "expressionWeight": 1
        }
      },
      "voiceUrl": "v_s10_6c6e93ea.mp3"
    },
    {
      "id": "s11",
      "text": "",
      "choices": [
        {
          "id": "shion_d18_thanks",
          "text": "……ありがとうございます、先生",
          "goto": "c1",
          "setFlags": {
            "shion_c10": true
          }
        },
        {
          "id": "shion_d18_fate",
          "text": "先生も、そういう『縁』あったんですか？",
          "goto": "c2"
        }
      ]
    },
    {
      "id": "c1",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "礼はいいから。後悔だけはしなさんなよ",
      "avatars": {
        "teacher": {
          "expression": "relaxed",
          "expressionWeight": 1
        }
      },
      "end": true,
      "voiceUrl": "v_c1_5f19437f.mp3"
    },
    {
      "id": "c2",
      "speakerCharacterId": "teacher",
      "speaker": "白石先生",
      "text": "定時退勤の邪魔する気？",
      "avatars": {
        "teacher": {
          "expression": "nima",
          "expressionWeight": 1,
          "motion": "Standing Greeting"
        }
      },
      "end": true,
      "voiceUrl": "v_c2_392b2be0.mp3"
    }
  ]
