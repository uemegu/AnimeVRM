    {
      "id": "s13",
      "speakerCharacterId": "emili",
      "speaker": "エミリ",
      "text": "私はスイスには行かない。自分の友達と、ここで、自分の青春を生きたいの",
      "avatars": {
        "emili": {
          "expression": "relaxed",
          "expressionWeight": 1
