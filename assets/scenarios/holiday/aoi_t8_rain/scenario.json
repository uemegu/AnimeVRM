      "voiceUrl": "v_s11_65def53a.mp3"
    },
    {
      "id": "s12",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "私のヒーローは、ほんとに、ずるい。",
      "avatars": {
        "aoi": {
          "expression": "relaxed"
        }
      },
      "nextSceneId": "end",
