      "avatars": {
        "aoi": {
          "position": "center",
          "expression": "happy",
          "motion": "ardy_pray"
        }
      }
    },
    {
      "id": "s2",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "あ、タカシくん。……えへへ、お礼参り。この前、みんなが無事だったから。",
      "voiceUrl": "v_s2_954d3668.mp3"
    },
    {
      "id": "s3",
      "text": "その時、空が急に暗くなり――大粒の雨が、境内を叩き始めた。",
      "background": "shrine_rain",
      "avatars": {
        "aoi": {
          "position": "center",
          "expression": "surprised",
          "motion": "ardy_startled"
        }
      },
      "seUrl": "/se/walking.mp3"
    },
    {
      "id": "s4",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "きゃっ、夕立！ タカシくん、こっち！",
      "voiceUrl": "v_s4_a661ab69.mp3"
    },
    {
      "id": "s5",
      "text": "拝殿の軒下に駆け込む。肩が触れる。雨音だけが、世界を満たしていく。",
      "avatars": {
        "aoi": {
          "position": "center",
          "expression": "relaxed",
          "motion": "Standing Idle"
        }
      },
      "camera": "medium"
    },
    {
      "id": "s6",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "……私ね。前の学校で、ずっとひとりだったの。",
      "avatars": {
        "aoi": {
          "expression": "sad"
        }
      },
      "voiceUrl": "v_s6_75ca1fd2.mp3"
    },
    {
      "id": "s7",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "引っ越しばっかりで、友達もすぐいなくなって。だから、戻ってくるの、怖かった。",
      "avatars": {
        "aoi": {
          "expression": "sad"
        }
      },
      "voiceUrl": "v_s7_62cb159d.mp3"
    },
    {
      "id": "s8",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "でもタカシくんは、昔と同じ顔で「おはよう」って言ってくれた。",
      "camera": "close",
      "avatars": {
        "aoi": {
          "expression": "relaxed"
        }
      },
      "voiceUrl": "v_s8_a91c219e.mp3"
    },
    {
      "id": "s9",
      "text": "",
      "camera": "wide",
      "choices": [
        {
          "id": "c1_1",
          "text": "「救われてるのは俺の方だ。アオイがいるから、毎日が楽しい」",
          "goto": "good",
          "setFlags": {
            "aoi_t8_rain": true
          },
          "addAffinity": {
            "aoi": 2
          }
        },
        {
          "id": "c1_2",
          "text": "「これからは、ずっと友達だから大丈夫」",
          "goto": "friend",
          "addAffinity": {
            "aoi": 1
          }
        },
        {
          "id": "c1_3",
          "text": "雨に濡れたアオイのブラウスが気になって、何も言えない",
          "goto": "hentai"
        }
      ]
    },
    {
      "id": "good",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "……っ。",
      "avatars": {
        "aoi": {
          "expression": "surprised"
        }
