      "id": "step_2",
      "speaker": "アオイ",
      "text": {
        "ja": "明日の朝渡すね。『町内清掃のお知らせ』が入ってるって、おばさんに伝えといて"
      },
      "expression": "neutral",
      "expressionWeight": 1,
      "nextStepId": "step_3",
      "voiceUrl": "v_step_2_8f89d001.mp3"
