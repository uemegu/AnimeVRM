      "expression": "angry",
      "expressionWeight": 1,
      "nextStepId": "step_4",
      "voiceUrl": "v_step_3_411d21bd.mp3"
    },
    "step_4": {
      "id": "step_4",
      "speaker": "",
      "text": {
        "ja": "（しばらく、クラスの噂話や来週の体育の話が続く）"
