    "step_1": {
      "id": "step_1",
      "speaker": "アオイ",
      "text": {
        "ja": "タカシくん、今いい？　お母さんがまだ帰ってなくて……このマンションって、段ボール何曜日に出せばいいの？"
      },
      "expression": "komari",
      "expressionWeight": 1,
      "nextStepId": "step_2"
    },
    "step_2": {
      "id": "step_2",
      "speaker": "タカシ",
      "text": {
        "ja": "資源ごみは第二・第四水曜。紐で十字に縛って、ガムテープは剥がす。伝票も剥がせよ、名前と住所が書いてあるから"
      },
      "nextStepId": "step_3"
    },
    "step_3": {
      "id": "step_3",
      "speaker": "アオイ",
      "text": {
        "ja": "……ごめん、メモするからもう一回ゆっくり"
      },
      "expression": "happy",
      "expressionWeight": 1,
      "nextStepId": "step_4"
    },
    "step_4": {
      "id": "step_4",
      "speaker": "",
      "text": {
        "ja": "（ペンの音。アオイの後ろに、封をしたままの段ボールが積んである）"
      },
      "nextStepId": "step_5"
    },
    "step_5": {
      "id": "step_5",
      "speaker": "タカシ",
      "text": {
        "ja": "……まだ結構残ってるな"
      },
      "nextStepId": "step_6"
    },
    "step_6": {
      "id": "step_6",
      "speaker": "アオイ",
      "text": {
        "ja": "うん。引っ越して二週間なのに、半分も開けてないの"
      },
      "expression": "relaxed",
      "expressionWeight": 1,
      "nextStepId": "step_7"
    },
    "step_7": {
      "id": "step_7",
      "speaker": "アオイ",
      "text": {
        "ja": "開けたら、前の学校のものばっかり出てきそうで。……寄せ書きとか"
      },
      "expression": "sad",
      "expressionWeight": 1,
      "nextStepId": "c8"
    },
    "c8": {
      "id": "c8",
      "speaker": "",
      "text": "",
      "choices": [
        {
          "id": "aoi_quiz_keep",
          "text": {
            "ja": "次の水曜までに、一緒に開けるか？　畳むのは得意だ"
          },
          "goto": "c1",
          "addAffinity": {
            "aoi": 2
          }
        },
        {
          "id": "aoi_quiz_next",
          "text": {
            "ja": "無理に開けなくてもいいだろ。急ぐもんでもないし"
          },
          "goto": "c2",
          "addAffinity": {
            "aoi": 1
          }
        }
      ]
    },
    "c1": {
      "id": "c1",
      "speaker": "アオイ",
      "text": {
        "ja": "……段ボール畳むのが得意な人、初めて見た"
      },
      "expression": "happy",
      "expressionWeight": 1,
      "nextStepId": "step_10"
    },
    "step_10": {
      "id": "step_10",
      "speaker": "アオイ",
      "text": {
