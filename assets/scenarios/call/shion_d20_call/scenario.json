    "step_2": {
      "id": "step_2",
      "speaker": "タカシ",
      "text": {
        "ja": "明日の夕方、あの神社に来てほしい"
      },
      "nextStepId": "step_3"
    },
    "step_3": {
      "id": "step_3",
      "speaker": "シオン",
      "text": {
        "ja": "……解呪の告白なら、あなたが想う相手とするべきでしょう"
      },
      "nextStepId": "step_4",
      "voiceUrl": "v_step_3_9d35eca1.mp3"
    },
    "step_4": {
      "id": "step_4",
      "speaker": "タカシ",
      "text": {
        "ja": "ああ。だから、シオンに来てほしいんだ"
      },
      "nextStepId": "step_5"
    },
    "step_5": {
      "id": "step_5",
      "speaker": "シオン",
      "text": {
        "ja": "…………"
