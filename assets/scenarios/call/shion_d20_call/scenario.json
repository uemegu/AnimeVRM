      "voiceUrl": "v_step_5_4bc7b57e.mp3"
    },
    "step_6": {
      "id": "step_6",
      "speaker": "タカシ",
      "text": {
        "ja": "シオンは、俺の気持ちが本物か検証できないって言ったよな"
      },
      "nextStepId": "step_7"
    },
    "step_7": {
      "id": "step_7",
      "speaker": "タカシ",
      "text": {
        "ja": "でも、シオンが解読した旧記が正しいなら、５秒様は偽りを通さない。打算の告白なら、俺は雷に打たれる"
      },
      "nextStepId": "c8"
    },
    "c8": {
      "id": "c8",
      "speaker": "",
      "text": "",
      "choices": [
        {
          "id": "shion_d20_trust",
          "text": {
            "ja": "だから、検証してくれ。シオンの調べたことを、俺は信じてる"
          },
          "goto": "c1",
          "setFlags": {
            "shion_promise": true,
            "shion_trust": true
          },
          "condition": {
            "minAffinity": {
              "shion": 19
            }
          }
        },
        {
          "id": "shion_d20_threat",
          "text": {
            "ja": "来てくれないと、俺、黒焦げになる"
          },
          "goto": "c2",
          "setFlags": {
            "shion_promise": true
          }
        }
      ]
    },
    "c1": {
      "id": "c1",
      "speaker": "シオン",
      "text": {
        "ja": "……ずるい人ね。私の研究を、そんなふうに使うなんて"
      },
      "nextStepId": "step_10",
      "voiceUrl": "v_c1_32836f78.mp3"
    },
    "step_10": {
      "id": "step_10",
      "speaker": "シオン",
      "text": {
        "ja": "……いいわ。その検証、見届ける"
      },
      "nextStepId": "merge",
      "voiceUrl": "v_step_10_5432752f.mp3"
    },
    "c2": {
      "id": "c2",
      "speaker": "シオン",
      "text": {
        "ja": "……脅しは非論理的よ。……でも、見届けるのは被験者への責任ね"
      },
      "nextStepId": "merge",
      "voiceUrl": "v_c2_9651e437.mp3"
    },
    "merge": {
      "id": "merge",
      "speaker": "シオン",
      "text": {
        "ja": "……絶対に逃げないでよね、タカシ"
      },
