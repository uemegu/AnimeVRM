{
  "id": "shion_call_return",
  "title": {
    "ja": "返却期限の確認"
  },
  "priority": 1,
  "availability": {
    "dayRange": {
      "from": 4,
      "to": 10
    },
    "after": {
      "all": [
        {
          "scenarioId": "shion_d01_library"
        }
      ]
    }
  },
  "characterId": "shion",
  "audioOnly": true,
  "initialStepId": "step_1",
  "steps": {
    "step_1": {
      "id": "step_1",
      "speaker": "シオン",
      "text": {
        "ja": "夜分に失礼。図書委員長としての事務連絡よ。あなたが借りた歴史小説、返却期限は明日"
      },
      "nextStepId": "step_2",
      "voiceUrl": "v_step_1_7e0b6f5f.mp3"
    },
    "step_2": {
      "id": "step_2",
      "speaker": "タカシ",
      "text": {
        "ja": "もう読み終わったから明日返すよ。めちゃくちゃ面白かった"
      },
      "nextStepId": "step_3"
    },
    "step_3": {
      "id": "step_3",
      "speaker": "シオン",
      "text": {
        "ja": "……もう読了したの？　上下巻で八百ページ近くあるのに"
      },
      "nextStepId": "c4",
      "voiceUrl": "v_step_3_178f4431.mp3"
    },
    "c4": {
      "id": "c4",
      "speaker": "",
      "text": "",
      "choices": [
        {
          "id": "shion_return_loved",
          "text": {
            "ja": "最後に城を明け渡すところ、あれは負けじゃなくて勝ちだよな"
          },
          "goto": "c1",
          "addAffinity": {
            "shion": 3
          }
        },
        {
          "id": "shion_return_skim",
          "text": {
            "ja": "最後の方は斜め読みだけど"
          },
          "goto": "c2"
        }
      ]
    },
    "c1": {
      "id": "c1",
      "speaker": "シオン",
      "text": {
        "ja": "……そう読んだの"
      },
      "nextStepId": "step_6"
    },
    "step_6": {
      "id": "step_6",
      "speaker": "シオン",
      "text": {
        "ja": "あの場面で泣いた人の感想は、たくさん見たわ。でも、勝ちだと言ったのはあなたが初めて"
      },
      "nextStepId": "step_7"
    },
    "step_7": {
      "id": "step_7",
      "speaker": "",
      "text": {
        "ja": "（そこから十分ほど、静かな熱を帯びた読書談義が続いた）"
      },
      "nextStepId": "merge"
    },
    "c2": {
      "id": "c2",
      "speaker": "シオン",
      "text": {
        "ja": "……感想は、ちゃんと読んでから聞くわ"
      },
      "nextStepId": "merge",
      "voiceUrl": "v_c2_caaa5c84.mp3"
    },
    "merge": {
      "id": "merge",
      "speaker": "シオン",
      "text": {
        "ja": "……下巻の最後の一行、明日もう一度確かめたいの。返しに来る時、少し時間をちょうだい"
      },
      "nextStepId": null
    }
  }
}
