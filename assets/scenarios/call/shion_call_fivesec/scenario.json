  "initialStepId": "step_1",
  "steps": {
    "step_1": {
      "id": "step_1",
      "speaker": "シオン",
      "text": {
        "ja": "今日複写した『社寺旧記』の一節。『心の迷い、時を費やすほどに深し』"
      },
      "nextStepId": "step_2",
      "voiceUrl": "v_step_1_289efb49.mp3"
    },
    "step_2": {
      "id": "step_2",
      "speaker": "シオン",
      "text": {
        "ja": "５秒という短すぎる制限は……迷いや計算を挟ませないための、安全装置なのかもしれないわ"
      },
      "nextStepId": "step_3",
      "voiceUrl": "v_step_2_48d82760.mp3"
    },
    "step_3": {
      "id": "step_3",
      "speaker": "タカシ",
      "text": {
        "ja": "安全装置？"
      },
      "nextStepId": "step_4"
    },
    "step_4": {
      "id": "step_4",
      "speaker": "シオン",
      "text": {
        "ja": "人は時間をかけるほど、プライドや恐怖で本心を隠す。だから、５秒の中で本音だけを言わせる"
      },
      "nextStepId": "c5",
      "voiceUrl": "v_step_4_a75408b9.mp3"
    },
    "c5": {
      "id": "c5",
      "speaker": "",
      "text": "",
      "choices": [
        {
          "id": "shion_fivesec_thanks",
          "text": {
            "ja": "じゃあ、５秒で言えるように、今のうちに考えとく"
          },
          "goto": "c1",
          "addAffinity": {
            "shion": 3
          }
        },
        {
          "id": "shion_fivesec_intro",
          "text": {
            "ja": "５秒って、自己紹介も終わらないよな"
          },
          "goto": "c2",
          "addAffinity": {
            "shion": 1
          }
        }
      ]
    },
    "c1": {
      "id": "c1",
      "speaker": "シオン",
      "text": {
        "ja": "……考えすぎたら、それこそ安全装置に引っかかるわよ"
      },
      "nextStepId": "step_7"
    },
    "step_7": {
      "id": "step_7",
      "speaker": "シオン",
      "text": {
        "ja": "……でも、そうね。考えるのは、悪いことじゃない"
      },
      "nextStepId": "step_8"
    },
    "step_8": {
      "id": "step_8",
      "speaker": "シオン",
      "text": {
        "ja": "旧記の続きは明日読むわ。おやすみなさい"
      },
      "nextStepId": null
    },
    "c2": {
      "id": "c2",
      "speaker": "シオン",
      "text": {
        "ja": "……ええ。だから、言うべきことだけを言うのよ"
      },
      "nextStepId": null,
      "voiceUrl": "v_c2_8deb95b1.mp3"
    }
  }
}
