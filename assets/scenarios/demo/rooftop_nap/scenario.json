    {
      "id": "rooftop_nap_5",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "「……あ、起きた。ふふ、おはよう。……ん？ なにじっと見てるの？ 私の顔、変……？」",
      "voiceUrl": "/voices/rooftop_04.mp3",
      "camera": "close"
    },
    {
      "id": "rooftop_nap_6",
      "speaker": "アオイ",
      "speakerCharacterId": "aoi",
      "text": "「……えっ？ ちょっと、待って……どこ見て――きゃあっ！？ わ、わたし、スカートでこんな屈み方……っ！！」",
      "voiceUrl": "/voices/rooftop_05.mp3",
