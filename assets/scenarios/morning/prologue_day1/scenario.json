      "camera": "side",
      "voiceUrl": "v_s7_4d4c45c8.mp3"
    },
    {
      "id": "s8",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "裏山の神社な。なんにも変わってないよ",
      "avatars": {
        "aoi": {
          "expression": "happy",
          "expressionWeight": 1
        }
      }
    },
    {
      "id": "s9",
      "speakerCharacterId": "aoi",
      "speaker": "アオイ",
      "text": "新学期のご挨拶、していこ？",
      "voiceUrl": "v_s9_30a3391d.mp3"
    },
    {
      "id": "s10",
      "speakerCharacterId": "aoi",
      "speaker": "アオイ",
      "text": "……今年も、みんなと仲良く楽しい一年になりますように",
