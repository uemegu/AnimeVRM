    },
    {
      "id": "s4",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "（分かってたけど……こんなに変わってるとは思わないだろ）",
      "avatars": {
        "aoi": {
          "anger": false,
          "expression": "neutral",
          "expressionWeight": 1
        }
      }
    },
    {
      "id": "s5",
      "speakerCharacterId": "aoi",
      "speaker": "アオイ",
      "text": "タカシくんこそ。昔は泥だらけの半ズボンだったのに、制服似合ってるね",
      "avatars": {
        "aoi": {
          "expression": "happy",
          "expressionWeight": 1,
          "motion": "aoi_feminine_hair_tuck"
        }
      },
      "camera": "close",
      "voiceUrl": "v_s5_8402c69e.mp3"
    },
    {
      "id": "s6",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "いつの話だよ……",
      "camera": "medium"
    },
    {
      "id": "s7",
      "speakerCharacterId": "aoi",
      "speaker": "アオイ",
      "text": "あ、この神社まだあったんだ！　懐かしい",
