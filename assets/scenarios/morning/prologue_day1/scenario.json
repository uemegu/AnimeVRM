      "camera": "medium",
      "screenTransition": "fade_black",
      "voiceUrl": "v_s10_06ca85e6.mp3"
    },
    {
      "id": "s11",
      "speakerCharacterId": "player",
      "speaker": "タカシ",
      "text": "（俺は……今年こそ何か変わりますように。彼女ができる、とか。……いや、どうせ無理か）"
    },
    {
      "id": "s12",
      "speakerCharacterId": "god",
      "speaker": "女神",
      "text": "『どうせ無理』……？　自分では何もせず神頼みとは、虫酸が走るほど情けない！",
      "flashEffect": "white",
      "seUrl": "/se/piano_note.mp3",
      "background": "god_realm",
      "timeOfDay": "divine",
      "bgm": "mysterious",
      "clearCast": true,
      "avatars": {
        "god": {
          "position": "center",
