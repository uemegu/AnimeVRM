{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "server"
      ],
      "port": 5190
    },
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "studio"
      ],
      "port": 5175
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "studio/vite.pages.config.ts"
      ],
      "port": 5177
    },
    {
      "name": "home-splat",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5199",
        "--directory",
        "scratch/home-splat"
      ],
      "port": 5199
    }
  ]
}
