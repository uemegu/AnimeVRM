        "ja": "",
        "en": ""
      },
      "choices": [
        {
          "id": "aoi_call_choice_1",
          "text": {
            "ja": "俺も話せて嬉しかったよ",
            "en": "I was really happy to talk with you too."
          },
          "goto": "step_happy",
