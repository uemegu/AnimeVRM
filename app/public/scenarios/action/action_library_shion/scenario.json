    {
      "id": "s_choice",
      "text": "",
      "choices": [
        {
          "text": {
            "ja": "シオンのおすすめの本を教えてほしい",
            "en": "I'd like you to recommend a book."
          },
          "goto": "s_recommend",
          "setFlags": {
            "asked_shion_book": true
          },
          "addAffinity": {
            "shion": 5
          }
        },
        {
          "text": {
            "ja": "邪魔しないように隣で静かに本を読むよ",
