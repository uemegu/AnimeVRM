        "en": "Shion"
      },
      "speakerCharacterId": "shion",
      "text": {
        "ja": "……あ。こんにちは。あなたも本を探しに来たのですか？",
        "en": "...Ah. Hello. Did you come looking for a book as well?"
      },
      "avatars": {
        "shion": {
          "characterId": "shion",
          "position": "center",
          "visible": true,
          "expression": "neutral",
          "expressionWeight": 1
        }
      }
